# Copiar a `.env` y completar.
#
# Estas dos variables son de servidor: se importan desde `$env/static/private`
# y nunca llegan al navegador. La service_role key ignora RLS, asi que no debe
# publicarse ni commitearse.
#
# SUPABASE_SERVICE_ROLE_KEY se copia del dashboard:
#   Project Settings -> API Keys -> service_role (secret)
#   https://supabase.com/dashboard/project/ihqirdjsrxqovxjwtoto/settings/api-keys

SUPABASE_URL=https://ihqirdjsrxqovxjwtoto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
