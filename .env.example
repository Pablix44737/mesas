# Copiar a `.env` y completar.
#
# Son variables de servidor: se leen desde `$env/dynamic/private` y nunca llegan
# al navegador. La service_role key ignora RLS, asi que no debe publicarse ni
# commitearse.
#
# SUPABASE_SERVICE_ROLE_KEY se copia del dashboard:
#   Project Settings -> API Keys -> service_role (secret)
#   https://supabase.com/dashboard/project/ihqirdjsrxqovxjwtoto/settings/api-keys

SUPABASE_URL=https://ihqirdjsrxqovxjwtoto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Clave de la zona de plataforma (/plataforma): la que da de alta instituciones y
# les restablece la clave. No tiene valor por defecto a proposito — si se deja
# vacia, esa zona no existe y responde 404 como cualquier direccion inventada.
# Cambiarla corta en el acto las sesiones de plataforma abiertas.
#
# La clave de la administracion NO va aca: es de cada institucion, se guarda
# hasheada en la base y se fija al darla de alta.
CLAVE_PLATAFORMA=
